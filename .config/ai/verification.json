{
  "version": 1,
  "steps": [
    {
      "id": "build",
      "category": "build",
      "applicability": "required",
      "failure_policy": "blocking",
      "command": ["{python}", "-m", "py_compile", ".config/ai/tools/fishdev.py", ".config/ai/tools/release.py"]
    },
    {
      "id": "tests",
      "category": "tests",
      "applicability": "required",
      "failure_policy": "blocking",
      "command": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-q"]
    },
    {
      "id": "browser",
      "category": "browser",
      "applicability": "inapplicable",
      "failure_policy": "blocking",
      "reason": "FishDev has no browser interface."
    },
    {
      "id": "security",
      "category": "security",
      "applicability": "required",
      "failure_policy": "blocking",
      "command": ["{python}", ".config/ai/tools/fishdev.py", "check"]
    },
    {
      "id": "release",
      "category": "security",
      "applicability": "required",
      "failure_policy": "blocking",
      "command": ["{python}", ".config/ai/tools/release.py", "check"]
    },
    {
      "id": "performance",
      "category": "performance",
      "applicability": "inapplicable",
      "failure_policy": "blocking",
      "reason": "FishDev has no runtime service or performance budget."
    },
    {
      "id": "learning",
      "category": "learning",
      "applicability": "required",
      "failure_policy": "advisory",
      "command": ["{python}", ".config/ai/tools/fishdev.py", "retro"]
    }
  ]
}
